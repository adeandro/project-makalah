------MultipartBoundary--J1ykC57hWXfM3Pg0WgK70UvWJ10WjLhu4UrLpG9qPJ----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-9851bf83-12d6-4760-804f-4ba390804036@mhtml.blink

@charset "utf-8";

.ns-qr9ag-l-squareLVideoTextCta { opacity: 1; position: relative; }

.video-playing .ns-qr9ag-l-squareLVideoTextCta a.video-clickable-anchor { display: block; }

.video-paused .ns-qr9ag-l-squareLVideoTextCta a.video-clickable-anchor { display: block; }

.end-card-shown .ns-qr9ag-l-squareLVideoTextCta .end-frame { display: block; }

.ns-qr9ag-l-squareLVideoTextCta a[data-asoch-targets$="ochTitle"][highlighted="true"] { background: linear-gradient(0deg, rgba(57, 116, 186, 0.5) 10%, transparent 10%); }

.ns-qr9ag-e-0 { background-color: rgb(255, 255, 255); }

.ns-qr9ag-e-5 { background-image: url("//img.youtube.com/vi/t5D2SjytbPc/hqdefault.jpg"); background-position: center center; background-repeat: no-repeat; background-size: cover; }

.ns-qr9ag-e-6 { background: white; }

.ns-qr9ag-e-7 { color: rgb(0, 0, 0); overflow: visible; font-family: "Open Sans", "Open Sans", Arial, sans-serif; }

.ns-qr9ag-e-8, .ns-qr9ag-e-12, .ns-qr9ag-e-14, .ns-qr9ag-e-19 { white-space: nowrap; }

.ns-qr9ag-e-11 { color: rgb(92, 92, 92); overflow: visible; font-family: "Open Sans", "Open Sans", Arial, sans-serif; }

.ns-qr9ag-e-13 { color: rgb(151, 151, 151); opacity: 0.7; overflow: visible; font-family: "Open Sans", "Open Sans", Arial, sans-serif; }

.ns-qr9ag-e-17 { background-color: rgb(33, 33, 33); box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 2px 0px; border-radius: 4px; }

.ns-qr9ag-e-18 { color: rgb(255, 255, 255); overflow: visible; font-family: "Open Sans", "Open Sans", Arial, sans-serif; }
------MultipartBoundary--J1ykC57hWXfM3Pg0WgK70UvWJ10WjLhu4UrLpG9qPJ----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-b78a51a9-8b3c-4d6e-afb3-de3d9f9fd7f1@mhtml.blink

@charset "utf-8";

.ns-qr9ag-l-squareLVideoTextCta { opacity: 0.01; position: absolute; top: 0px; left: 0px; display: block; width: 360px; height: 360px; }

.ns-qr9ag-e-0 { box-sizing: border-box; width: 100%; height: 100%; font-family: "Open Sans", Arial, sans-serif; border: 1px solid rgb(236, 239, 241); }

.ns-qr9ag-e-1 { box-sizing: border-box; display: flex; flex-direction: column; height: 100%; }

.ns-qr9ag-e-2 { box-sizing: border-box; justify-content: center; height: 203px; position: relative; width: 100%; max-height: 252px; flex-shrink: 0; }

.ns-qr9ag-e-3 { box-sizing: border-box; height: 203px; display: none; overflow: hidden; width: 100%; max-height: 252px; }

.ns-qr9ag-e-4 { display: block; height: 100%; width: 100%; }

.ns-qr9ag-e-5 { box-sizing: border-box; width: 100%; height: 100%; }

.ns-qr9ag-e-6 { box-sizing: border-box; display: flex; flex-direction: column; height: 1px; flex-grow: 1; flex-shrink: 0; }

.ns-qr9ag-e-7 { box-sizing: border-box; overflow: hidden; flex-shrink: 0; line-height: 1.25em; text-align: left; font-weight: 700; white-space: nowrap; padding: 6.12px 14.4px; width: 100%; }

.ns-qr9ag-e-8, .ns-qr9ag-e-12, .ns-qr9ag-e-14 { }

.ns-qr9ag-e-9 { box-sizing: border-box; display: flex; align-items: center; flex-direction: row; flex-grow: 1; height: 1px; padding: 7.2px 14.4px; }

.ns-qr9ag-e-10 { box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; flex-grow: 1; height: 100%; width: 1px; }

.ns-qr9ag-e-11 { box-sizing: border-box; overflow: hidden; flex-shrink: 0; text-align: left; font-weight: 300; max-height: 2.2em; line-height: 1.1em; }

.ns-qr9ag-e-13 { box-sizing: border-box; overflow: hidden; flex-shrink: 0; line-height: 1.25em; text-align: left; font-weight: 300; white-space: nowrap; margin-top: 2.52px; }

.ns-qr9ag-e-15 { box-sizing: border-box; margin-left: 7.2px; flex-shrink: 0; }

.ns-qr9ag-e-16 { display: block; }

.ns-qr9ag-e-17 { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 0px 4px; height: 46.08px; width: 115.2px; }

.ns-qr9ag-e-18 { font-weight: 500; overflow: hidden; text-transform: capitalize; max-width: 100%; white-space: normal; line-height: 1.5em; }

.ns-qr9ag-e-19 { display: inline; }

.ns-qr9ag-e-20 { box-sizing: border-box; margin-left: 0.4em; }

.ns-qr9ag-e-21 { flex-shrink: 0; flex-grow: 0; display: block; height: 1em; }

.ns-qr9ag-v-0 .ns-qr9ag-e-0, .ns-qr9ag-v-0 .ns-qr9ag-e-7 { font-size: 26px; }

.ns-qr9ag-v-0 .ns-qr9ag-e-11 { font-size: 17px; }

.ns-qr9ag-v-0 .ns-qr9ag-e-13, .ns-qr9ag-v-0 .ns-qr9ag-e-17 { font-size: 15px; }

.ns-qr9ag-v-0 .ns-qr9ag-e-18 { max-height: 3em; }

.ns-qr9ag-v-0 .ns-qr9ag-e-20 { display: block; }
------MultipartBoundary--J1ykC57hWXfM3Pg0WgK70UvWJ10WjLhu4UrLpG9qPJ----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-63cc641d-d115-47dd-882c-c87ad2722566@mhtml.blink

@charset "utf-8";

html, body { height: 100%; width: 100%; margin: 0px; padding: 0px; overflow: hidden; }

#mys-wrapper { height: 100%; width: 100%; overflow: hidden; position: absolute; top: 0px; left: 0px; align-items: center; display: flex; justify-content: center; line-height: normal; }

#mys-overlay { height: 100%; width: 100%; overflow: hidden; position: absolute; top: 0px; left: 0px; box-sizing: border-box; pointer-events: none; z-index: 1; display: none; }

.mys-wrapper a, .mys-wrapper a:visited, .mys-wrapper a:hover, .mys-wrapper a:active { color: inherit; cursor: pointer; text-decoration: inherit; }

[dir="rtl"] .flip-on-rtl { transform: scale(-1, 1); transform-origin: center center; }

#mys-content { flex-shrink: 0; position: relative; overflow: hidden; z-index: 0; }
